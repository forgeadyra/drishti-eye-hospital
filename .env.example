# ─── Server-side ONLY (set in Netlify → Site settings → Environment variables) ───
# Never prefix these with VITE_ — anything VITE_* is bundled into public JS.
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Exact production origin allowed by CORS, e.g. https://www.example.com
ALLOWED_ORIGIN=

# ─── Public (bundled into client JS — safe to expose) ───
# Turnstile SITE key is public by design.
VITE_TURNSTILE_SITE_KEY=
